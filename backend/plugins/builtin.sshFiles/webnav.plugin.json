{
  "schemaVersion": 1,
  "id": "builtin.sshFiles",
  "name": "SSH 文件管理",
  "version": "0.1.0",
  "description": "通过独立 SFTP 通道管理远端文件，支持上传下载、目录定位、文本编辑与冲突检测。",
  "author": "LittleDock",
  "license": "随小站项目许可证",
  "category": "files",
  "secondaryCategories": [],
  "apiVersion": 1,
  "webnav": "^0.1.3",
  "node": ">=22.12.0",
  "platforms": [
    {
      "os": "win32",
      "arch": "x64"
    },
    {
      "os": "win32",
      "arch": "arm64"
    },
    {
      "os": "linux",
      "arch": "x64"
    },
    {
      "os": "linux",
      "arch": "arm64"
    },
    {
      "os": "darwin",
      "arch": "x64"
    },
    {
      "os": "darwin",
      "arch": "arm64"
    }
  ],
  "capabilities": [
    {
      "id": "service:sshFiles",
      "version": 1
    }
  ],
  "backend": "index.ts",
  "icon": "icon.svg",
  "readme": "README.md",
  "dataVersion": 1,
  "automation": {
    "version": 1,
    "description": "通过独立 SFTP 通道管理远端文件，支持上传下载、目录定位、文本编辑与冲突检测。 AI 可通过工作台调用下列能力。",
    "tools": [
      {
        "id": "files_list",
        "version": 1,
        "title": "列出目录",
        "description": "授权路径内有界分页；不跟随越界符号链接。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "taskId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "taskId",
            "path"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        },
        "scopes": [
          "files.read"
        ],
        "access": "read",
        "execution": "request",
        "binding": {
          "kind": "service",
          "capability": "service:sshFiles"
        },
        "contract": {
          "id": "files_list",
          "version": 1
        }
      },
      {
        "id": "files_read",
        "version": 1,
        "title": "读取文本",
        "description": "读取授权路径内最多 128 KiB 文本及版本。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "taskId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "taskId",
            "path"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        },
        "scopes": [
          "files.read"
        ],
        "access": "read",
        "execution": "request",
        "binding": {
          "kind": "service",
          "capability": "service:sshFiles"
        },
        "contract": {
          "id": "files_read",
          "version": 1
        }
      },
      {
        "id": "files_save",
        "version": 1,
        "title": "准备修改文本",
        "description": "返回旧/新正文预览及操作票据；workbench_apply 再核对版本并暂存提交。只修改已存在普通文件。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "taskId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "version": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "text": {
              "type": "string",
              "maxLength": 131072
            },
            "encoding": {
              "type": "string",
              "enum": [
                "utf8",
                "utf16le",
                "utf16be",
                "gb18030"
              ]
            },
            "bom": {
              "type": "boolean"
            },
            "lineEnding": {
              "type": "string",
              "enum": [
                "LF",
                "CRLF"
              ]
            }
          },
          "required": [
            "taskId",
            "path",
            "version",
            "text",
            "encoding",
            "bom",
            "lineEnding"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        },
        "scopes": [
          "files.write"
        ],
        "access": "write",
        "execution": "request",
        "binding": {
          "kind": "service",
          "capability": "service:sshFiles"
        },
        "contract": {
          "id": "files_save",
          "version": 1
        }
      }
    ]
  },
  "contributes": {
    "menuPoints": [
      {
        "id": "entry",
        "title": "SSH 文件菜单",
        "description": "SSH 文件项或当前目录的操作菜单。路径属于指定会话；写入仍需后端校验版本及权限。",
        "version": 1,
        "fields": {
          "sessionId": {
            "type": "string",
            "required": true,
            "description": "所属 SSH 会话 ID"
          },
          "path": {
            "type": "string",
            "required": true,
            "description": "所选项或当前目录的远端完整路径"
          },
          "name": {
            "type": "string",
            "required": true,
            "description": "所选项名称，目录空白处为空"
          },
          "kind": {
            "type": "string",
            "required": true,
            "description": "file、directory、link 或其他文件类型"
          }
        }
      }
    ]
  },
  "i18n": {
    "defaultLocale": "zh-CN",
    "locales": {
      "zh-CN": "locales/zh-CN.json",
      "en": "locales/en.json"
    }
  }
}
